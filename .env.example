NEWSDATA_API_KEY=
OPENROUTER_API_KEY=
# Verified through OpenRouter during the integration check; configurable.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional second model tried once when the primary fails; same prompt and validation.
OPENROUTER_FALLBACK_MODEL=
# Optional; relative paths are resolved from the project directory.
NEWS_MONITOR_DB_PATH=data/news.db
# Optional Docker host port; container storage always uses its named volume.
NEWS_MONITOR_PORT=8501
